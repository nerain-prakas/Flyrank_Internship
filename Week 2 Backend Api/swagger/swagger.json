{
  "openapi": "3.0.3",
  "info": {
    "title": "Todo API",
    "version": "1.0.0",
    "description": "REST API for managing an in-memory Todo list."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and API information endpoints"
    },
    {
      "name": "Tasks",
      "description": "CRUD operations for todo tasks"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Get API information",
        "description": "Returns the API name and version.",
        "responses": {
          "200": {
            "description": "API metadata",
            "content": {
              "application/json": {
                "example": {
                  "name": "Todo API",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    },
    "/hello": {
      "get": {
        "tags": ["System"],
        "summary": "Get hello message",
        "description": "Returns a simple welcome message for the service.",
        "responses": {
          "200": {
            "description": "Welcome message",
            "content": {
              "application/json": {
                "example": {
                  "message": "Hello from Todo API"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "Checks whether the API is running.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get all tasks",
        "description": "Returns all tasks, with optional filtering by done or search query.",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "required": false,
            "description": "Filter by completion state.",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "example": "true"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Case-insensitive search text for the task title.",
            "schema": {
              "type": "string"
            },
            "example": "learn"
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "title": "Learn Express", "done": false },
                  { "id": 2, "title": "Learn Swagger", "done": true }
                ]
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "example": {
                  "error": "done must be true or false"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "description": "Creates a new task with a generated id and done defaulting to false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              },
              "example": {
                "title": "New Task"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "example": {
                  "id": 4,
                  "title": "New Task",
                  "done": false
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Title is required"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a task by id",
        "description": "Returns a single task by its id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric task id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "title": "Learn Express",
                  "done": false
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Task not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update a task",
        "description": "Updates the title, done flag, or both for a task.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskRequest"
              },
              "example": {
                "title": "Updated Task",
                "done": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "title": "Updated Task",
                  "done": true
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "example": {
                  "error": "done must be a boolean"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Task not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "description": "Deletes a task by id and returns no content.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted"
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Task not found"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task statistics",
        "description": "Returns total, completed, and pending task counts.",
        "responses": {
          "200": {
            "description": "Statistics",
            "content": {
              "application/json": {
                "example": {
                  "total": 3,
                  "completed": 1,
                  "pending": 2
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "tags": ["Tasks"],
        "summary": "Reset tasks",
        "description": "Restores the initial sample tasks in memory.",
        "responses": {
          "200": {
            "description": "Tasks reset",
            "content": {
              "application/json": {
                "example": {
                  "message": "Tasks reset successfully",
                  "tasks": [
                    { "id": 1, "title": "Learn Express", "done": false },
                    { "id": 2, "title": "Learn Swagger", "done": true },
                    { "id": 3, "title": "Finish Assignment", "done": false }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "New Task"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Updated Task"
          },
          "done": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  }
}