{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth Protected API",
    "version": "1.0.0",
    "description": "Supabase-authenticated Express API for the FlyRank W2-A4 assignment."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/public/info": {
      "get": {
        "summary": "Get public information",
        "responses": {
          "200": {
            "description": "Public response"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Create a user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created"
          },
          "400": {
            "description": "Missing or rejected credentials"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in and receive tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access and refresh tokens"
          },
          "400": {
            "description": "Missing credentials"
          },
          "401": {
            "description": "Invalid login credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "End the authenticated session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": {
            "description": "Session ended"
          },
          "401": {
            "description": "Missing or invalid token"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read the authenticated user's profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Safe user metadata"
          },
          "401": {
            "description": "Missing, malformed, or invalid token"
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Read protected dashboard data",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Protected dashboard response"
          },
          "401": {
            "description": "Missing, malformed, or invalid token"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      }
    }
  }
}